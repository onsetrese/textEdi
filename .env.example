# Environment variables for the Collaborative Document Editor backend
# Copy this file to .env and fill in the values

# Secret key used to sign and verify JWT tokens
# Use a long, random, unguessable string in production
JWT_SECRET=your_secret_here

# Port on which the Express server listens
PORT=3001

# Allowed CORS origin for the frontend (Vite dev server default shown)
CLIENT_ORIGIN=http://localhost:5173
